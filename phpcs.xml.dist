<?xml version="1.0"?>
<ruleset name="ZEF Framework">
    <description>Strict coding standard for the ZEF Framework (PSR-12 + Slevomat).</description>

    <file>src</file>
    <file>tests</file>
    <file>benchmarks</file>

    <exclude-pattern>*/src/Contracts/Psr/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>

    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <arg name="parallel" value="8"/>
    <arg name="cache" value="build/phpcs.cache"/>
    <arg value="ps"/>

    <!-- The health probe's crash containment truncates the failure's class
         name at 128 characters; the bound is only observable from a fixture
         whose fully qualified name crosses it, and a class declaration line
         cannot be split. The aggregator suite's own `use` line spells the
         same name and carries a bare inline `phpcs:ignore` (phpcs 4 ignores
         the trailing-message form) for the same reason. -->
    <rule ref="Generic.Files.LineLength">
        <exclude-pattern>*/tests/Support/</exclude-pattern>
    </rule>

    <!-- The lazy lane's return-shape fixture: `none()` deliberately
         carries no native return type; its whole subject is the
         grammar's refusal of a lazy factory that cannot name its
         product's class, and the analysers read the docblock instead.
         The missing native hint is the fixture, not a defect. -->
    <rule ref="SlevomatCodingStandard.TypeHints.ReturnTypeHint.MissingNativeTypeHint">
        <exclude-pattern>*/tests/Support/Container/Lazy/LazyReturnShapes.php</exclude-pattern>
    </rule>

    <rule ref="PSR12"/>

    <!-- PHP's stream-wrapper protocol mandates snake_case method names
         (stream_open, stream_read, ...); the test fixtures that double that
         protocol cannot follow PSR1's camel-caps rule. -->
    <rule ref="PSR1.Methods.CamelCapsMethodName.NotCamelCaps">
        <exclude-pattern>*/tests/Support/Http/*StreamWrapper.php</exclude-pattern>
    </rule>

    <!-- The typed-exception root's default error code falls back to
         FRAMEWORK_ERROR only when the derived code's head is not an
         uppercase ASCII letter, and PHP refuses a class name that merely
         starts with a digit, so the one shape that reaches the fallback
         from a legal class name begins with a multibyte letter followed
         by a digit: a head the ASCII PascalCase grammar cannot admit by
         construction. The class-name rule excludes that one fixture. -->
    <rule ref="Squiz.Classes.ValidClassName.NotPascalCase">
        <exclude-pattern>*/tests/Support/Exception/Ü9ProbeException.php</exclude-pattern>
    </rule>

    <!-- Strict types -->
    <!--
        The PSR-7 interface hierarchy (RequestInterface <- ServerRequestInterface)
        is mirrored by the implementation classes: Request is the deliberately
        non-final parent of ServerRequest, because the repository carries zero
        traits, so the legacy RequestTrait's shared request-line behaviour
        became inheritance. A concrete instantiable outgoing request cannot be
        abstract, so this one class stays neither abstract nor final.
    -->
    <!--
        The definition-defect family's root has to stay neither abstract
        nor final: it is thrown directly (the grammar's own refusals) and
        subclassed by the lanes that refine declarations (the autowiring
        lane's AutowiringException), so a caller catching it catches every
        way a declaration can be refused.
    -->
    <!--
        The HTTP layer's exception root took the same dual shape when the
        error-handling lane grew the typed signals beneath it
        (PayloadTooLargeException): it is thrown directly by the layer's own
        guards, and subclassed by the typed family, so the fold's promised
        catchability keeps catching the typed refusals too.
    -->
    <rule ref="SlevomatCodingStandard.Classes.RequireAbstractOrFinal.ClassNeitherAbstractNorFinal">
        <exclude-pattern>*/src/Zef/Framework/Http/Request.php</exclude-pattern>
        <exclude-pattern>*/src/Zef/Framework/Container/DefinitionException.php</exclude-pattern>
        <exclude-pattern>*/src/Zef/Framework/Http/HttpException.php</exclude-pattern>
    </rule>
    <rule ref="SlevomatCodingStandard.TypeHints.DeclareStrictTypes">
        <properties>
            <property name="declareOnFirstLine" value="false"/>
            <property name="spacesCountAroundEqualsSign" value="0"/>
        </properties>
    </rule>
    <rule ref="SlevomatCodingStandard.TypeHints.ParameterTypeHint">
        <properties>
            <property name="enableMixedTypeHint" value="true"/>
            <property name="enableUnionTypeHint" value="true"/>
            <property name="enableIntersectionTypeHint" value="true"/>
        </properties>
    </rule>
    <rule ref="SlevomatCodingStandard.TypeHints.PropertyTypeHint">
        <properties>
            <property name="enableMixedTypeHint" value="true"/>
            <property name="enableUnionTypeHint" value="true"/>
            <property name="enableIntersectionTypeHint" value="true"/>
        </properties>
    </rule>
    <rule ref="SlevomatCodingStandard.TypeHints.ReturnTypeHint">
        <properties>
            <property name="enableMixedTypeHint" value="true"/>
            <property name="enableUnionTypeHint" value="true"/>
            <property name="enableIntersectionTypeHint" value="true"/>
        </properties>
    </rule>
    <rule ref="SlevomatCodingStandard.TypeHints.NullableTypeForNullDefaultValue"/>
    <rule ref="SlevomatCodingStandard.TypeHints.UselessConstantTypeHint"/>
    <rule ref="SlevomatCodingStandard.TypeHints.DisallowArrayTypeHintSyntax"/>

    <!-- Namespaces -->
    <rule ref="SlevomatCodingStandard.Namespaces.AlphabeticallySortedUses"/>
    <rule ref="SlevomatCodingStandard.Namespaces.UnusedUses">
        <properties>
            <property name="searchAnnotations" value="true"/>
        </properties>
    </rule>
    <rule ref="SlevomatCodingStandard.Namespaces.ReferenceUsedNamesOnly">
        <properties>
            <property name="allowFallbackGlobalFunctions" value="true"/>
            <property name="allowFallbackGlobalConstants" value="true"/>
            <property name="allowFullyQualifiedGlobalFunctions" value="true"/>
            <property name="allowFullyQualifiedGlobalConstants" value="true"/>
            <property name="searchAnnotations" value="true"/>
        </properties>
    </rule>
    <rule ref="SlevomatCodingStandard.Namespaces.NamespaceSpacing"/>

    <!-- Classes -->
    <rule ref="SlevomatCodingStandard.Classes.RequireAbstractOrFinal"/>
    <rule ref="SlevomatCodingStandard.Classes.ClassMemberSpacing"/>
    <rule ref="SlevomatCodingStandard.Classes.ConstantSpacing"/>
    <rule ref="SlevomatCodingStandard.Classes.SuperfluousAbstractClassNaming"/>
    <!--
        SuperfluousInterfaceNaming / SuperfluousExceptionNaming are intentionally
        NOT enabled: this framework mirrors the PSR (PHP-FIG) naming convention
        (ContainerInterface, NotFoundExceptionInterface, ...). Those two sniffs
        would forbid the very suffix the PSR standard mandates for our own
        contracts, so keeping them would contradict a higher-priority standard.
    -->

    <!-- Control structures -->
    <rule ref="SlevomatCodingStandard.ControlStructures.EarlyExit"/>
    <rule ref="SlevomatCodingStandard.ControlStructures.RequireNullCoalesceOperator"/>
    <rule ref="SlevomatCodingStandard.ControlStructures.UselessTernaryOperator"/>
    <rule ref="SlevomatCodingStandard.ControlStructures.DisallowYodaComparison"/>

    <!-- Functions -->
    <rule ref="SlevomatCodingStandard.Functions.StaticClosure"/>
    <rule ref="SlevomatCodingStandard.Functions.StrictCall"/>
    <rule ref="SlevomatCodingStandard.Functions.DisallowEmptyFunction"/>
    <rule ref="SlevomatCodingStandard.Functions.UselessParameterDefaultValue"/>

    <!-- Exceptions -->
    <rule ref="SlevomatCodingStandard.Exceptions.DeadCatch"/>
    <rule ref="SlevomatCodingStandard.Exceptions.ReferenceThrowableOnly"/>
    <rule ref="SlevomatCodingStandard.Exceptions.RequireNonCapturingCatch"/>

    <!-- Variables -->
    <rule ref="SlevomatCodingStandard.Variables.DuplicateAssignmentToVariable"/>
    <rule ref="SlevomatCodingStandard.Variables.UnusedVariable"/>
    <rule ref="SlevomatCodingStandard.Variables.UselessVariable"/>

    <!-- Arrays / PHP -->
    <rule ref="SlevomatCodingStandard.Arrays.TrailingArrayComma"/>
    <rule ref="SlevomatCodingStandard.Arrays.DisallowImplicitArrayCreation"/>
    <rule ref="SlevomatCodingStandard.PHP.UselessParentheses"/>
    <rule ref="SlevomatCodingStandard.PHP.TypeCast"/>
    <rule ref="SlevomatCodingStandard.PHP.RequireExplicitAssertion"/>

    <!-- Comments -->
    <rule ref="SlevomatCodingStandard.Commenting.EmptyComment"/>
    <rule ref="SlevomatCodingStandard.Commenting.ForbiddenAnnotations">
        <properties>
            <property name="forbiddenAnnotations" type="array">
                <element value="@author"/>
                <element value="@created"/>
                <element value="@license"/>
                <element value="@package"/>
                <element value="@copyright"/>
                <element value="@version"/>
            </property>
        </properties>
    </rule>
    <rule ref="SlevomatCodingStandard.Commenting.RequireOneLinePropertyDocComment"/>
</ruleset>

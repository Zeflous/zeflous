<?xml version="1.0"?>
<psalm
    errorLevel="1"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    findUnusedBaselineEntry="true"
    findUnusedCode="true"
    errorBaseline="psalm-baseline.xml"
>
    <projectFiles>
        <directory name="src" />
        <ignoreFiles>
            <directory name="vendor" />
        </ignoreFiles>
    </projectFiles>
    <!-- Optional-dependency analysis stubs: the phpredis extension's class and
         the Guzzle transport-failure contract the error boundary recognises,
         seen by the analyser in environments that carry neither at runtime. -->
    <stubs>
        <file name="stubs/ext-redis.php" />
        <file name="stubs/guzzle-exception.php" />
    </stubs>
</psalm>

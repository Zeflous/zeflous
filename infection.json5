{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "src/Zef"
        ]
    },
    "logs": {
        "text": "build/infection/infection.log",
        "html": "build/infection/infection.html",
        "summary": "build/infection/summary.log",
        "json": "build/infection/infection.json",
        "perMutator": "build/infection/per-mutator.md"
    },
    "tmpDir": "build/infection",
    "testFramework": "phpunit",
    "bootstrap": "vendor/autoload.php",
    "phpUnit": {
        "configDir": "."
    },
    "mutators": {
        "@default": true,
        // The SAPI header() call is the one function whose removal no test
        // process can observe: the CLI SAPI silently discards header fields
        // (headers_list() stays empty even while headers_sent() answers
        // false -- verified against the engine), so the real-branch call in
        // SapiTransmitter::field() is executed for coverage but is
        // structurally unverifiable in a phpunit process. The neighbouring
        // http_response_code() call stays under the mutator: the CLI keeps
        // its state observable and its removal is killed by the real-SAPI
        // test. This ignore is scoped to that single method.
        "FunctionCallRemoval": {
            "ignore": [
                "Zef\\Framework\\Http\\SapiTransmitter::field"
            ]
        },
        // The byte-length measurement in BodyBudget::refuses() is the one
        // call the MBString mutator can rewrite without any observable
        // difference: mb_strlen($data, '8bit') and strlen($data) both
        // answer the exact byte count of $data for every possible input
        // (the '8bit' encoding IS byte semantics; verified by running the
        // full suite under the manually applied mutation -- the complete
        // suite passes). The neighbouring mb_substr calls elsewhere in
        // the layer stay under the mutator: dropping their encoding
        // argument changes character semantics on binary payloads and
        // tests kill those. This ignore is scoped to that single method.
        //
        // The method-token fold in ETagMiddleware::applyConditionalGet()
        // is the second: mb_strtoupper($method) and strtoupper($method)
        // agree for every input whose fold can reach the GET/HEAD gate.
        // A token that differs between the two folds must contain a
        // non-ASCII character, and no character in the engine's case map
        // upper-cases into the ASCII letters G, E, T, H, A or D (the
        // non-ASCII-to-ASCII upper-case exceptions -- U+017F to S, the
        // ff/fi/fl/ffi ligatures to their ASCII expansions -- never spell
        // GET or HEAD), so such a token fails the gate under both folds
        // and the response flows through untouched either way. The
        // neighbouring mb_trim calls stay under the mutator: MBString
        // does not target mb_trim. This ignore is scoped to that single
        // method.
        //
        // The credential candidate's measurements in
        // RedactionCandidate::edit() are the third: the candidate grammar
        // is pure ASCII by construction (byte-mode classes -- the key, the
        // separator and the value regions can only contain ASCII bytes),
        // so mb_strlen and mb_substr agree with strlen and substr on
        // every string the grammar can ever hand them (verified by
        // running the full suite under the manually applied mutations --
        // the complete suite passes). The neighbouring strcasecmp,
        // strcspn and substr_replace calls stay under the mutator: they
        // are not MBString targets. This ignore is scoped to that single
        // method.
        //
        // The toggle fold in SecurityHeadersPolicy::toggle() is the
        // fourth: mb_strtolower($value) and strtolower($value) agree for
        // every input whose fold can reach the closed boolean vocabulary.
        // The vocabulary's words (true/false, on/off, yes/no, 1/0) contain
        // no ASCII `k`, and the only single-character lower-case mapping
        // from non-ASCII into ASCII in the Unicode case map is U+212A
        // (KELVIN SIGN) to `k` (U+0130 to `i` plus a combining dot is a
        // two-character mapping, not a pure ASCII landing) -- so a value
        // that differs between the two folds can never spell a vocabulary
        // word, fails the closed-set comparison under both folds, and is
        // rejected with the knob named either way. The neighbouring
        // get_debug_type and in_array calls stay under the mutator where
        // applicable: they are not MBString targets. This ignore is
        // scoped to that single method.
        "MBString": {
            "ignore": [
                "Zef\\Framework\\Http\\BodyBudget::refuses",
                "Zef\\Framework\\Http\\ETagMiddleware::applyConditionalGet",
                "Zef\\Framework\\Http\\RedactionCandidate::edit",
                "Zef\\Framework\\Http\\SecurityHeadersPolicy::toggle"
            ]
        },
        // The match start's capture read in RedactionCandidate::edit() is
        // the one integer the increment can rewrite without any
        // observable difference: the candidate grammar anchors the whole
        // match at the key's first byte, so $match[0][1] (the match start)
        // and $match[1][1] (the key start) carry the same value for every
        // possible match, and the edit's start answer cannot change
        // (verified by running the full suite under the manually applied
        // mutation -- the complete suite passes). The decrement direction
        // stays under the mutator: it reads the undefined capture -1, the
        // engine answers an undefined-dimension error, and tests kill it.
        // The ignore is scoped to that single source line.
        "IncrementInteger": {
            "ignoreSourceCodeByRegex": [
                "\\$matchStart = \\$match\\[0\\]\\[1\\];"
            ]
        },
        // The scan resume's capture read in RedactedMessage::of() is the
        // one integer the decrement can rewrite without any observable
        // difference: the separator region between the key and the value
        // can host no candidate start (its bytes are whitespace and one
        // [=:], never a key byte), so resuming at the quote capture's
        // offset -- the value region's first byte -- and resuming at the
        // separator capture's offset select the identical next candidate
        // for every possible message (verified by running the full suite
        // under the manually applied mutation -- the complete suite
        // passes). The increment direction stays under the mutator: it
        // reads the undefined capture 4, the engine answers an
        // undefined-dimension error, and tests kill it. The ignore is
        // scoped to that single source line.
        "DecrementInteger": {
            "ignoreSourceCodeByRegex": [
                "\\$offset = \\$match\\[3\\]\\[1\\];"
            ]
        },
        // The settled memo's early return in
        // ServiceDefinitionGraph::visit() is the one return whose removal
        // is value-equivalent: the walk is a pure function of the edge
        // map, so re-visiting a settled node recomputes the identical
        // acyclic verdict -- the memo is a performance guard, never a
        // correctness branch, and the cycle detector's chain test is
        // independent of it (verified by running the full suite under the
        // manually applied mutation -- the complete suite passes, cycles
        // still rejected, shared dependencies still accepted). The throw
        // and the recursion in the same method stay under their mutators:
        // tests kill those. This ignore is scoped to that single method.
        "ReturnRemoval": {
            "ignore": [
                "Zef\\Framework\\Container\\ServiceDefinitionGraph::visit"
            ]
        }
    },
    "minMsi": 100,
    "minCoveredMsi": 100,
    "ignoreMsiWithNoMutations": false,
    "threads": "max",
    "timeout": 10
}

            "ignoreSourceCodeByRegex": [
                "\\$method = mb_strtoupper\\(\\$request->getMethod\\(\\)\\);",
                // The event pattern's two tail cuts sit in zones the guards
                // above them have already proven ASCII: the constructor's
                // -2 cut runs only behind the str_ends_with '.*' check (the

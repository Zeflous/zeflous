# PHPStan extensions (strict-rules, deprecation-rules, phpunit) are auto-loaded
# by phpstan/extension-installer; they must not be included again here.
# bleedingEdge enables the strictest upcoming checks that are not yet in level max.
includes:
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon

parameters:
    level: max
    paths:
        - src
        - tests
        - benchmarks
    # The optional extensions' surfaces, as the rate-limit family's
    # boundaries see them (environments without them still analyse the
    # code): the phpredis class and the APCu functions.
    scanFiles:
        - stubs/ext-apcu.php
        - stubs/ext-redis.php
    tmpDir: build/phpstan
    treatPhpDocTypesAsCertain: true
    reportUnmatchedIgnoredErrors: true
    checkUninitializedProperties: true
    checkMissingCallableSignature: true
    checkMissingOverrideMethodAttribute: true
    checkDynamicProperties: true
    checkTooWideReturnTypesInProtectedAndPublicMethods: true
    checkPhpDocMissingReturn: true
    checkPhpDocMethodSignatures: true
    checkExplicitMixedMissingReturn: true
    checkBenevolentUnionTypes: true

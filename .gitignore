/vendor/
/build/
/tmp/
/.phpunit.cache/
/.phpunit.result.cache
/.php-cs-fixer.cache
/.deptrac.cache
/.sonar/
/composer.phar
/.idea/
/.vscode/
coverage.xml
junit.xml

# Python bytecode
__pycache__/
*.pyc

# Python coverage
.coverage
.coverage.*
htmlcov/
.pytest_cache/

# The storage layout's lanes: the structure is tracked (the .gitkeep
# pins each lane the vocabulary spells), the contents never are -- a
# log, a compiled cache, a replay snapshot and an uploaded file are
# all deployment state, not source.
/files/logs/*
!/files/logs/.gitkeep
/files/cache/*
!/files/cache/.gitkeep
/files/temp/*
!/files/temp/.gitkeep
/files/uploads/*
!/files/uploads/.gitkeep
/files/replay/*
!/files/replay/.gitkeep
/files/sessions/*
!/files/sessions/.gitkeep
/files/queue/*
!/files/queue/.gitkeep

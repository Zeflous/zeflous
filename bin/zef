#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * The one autoloader every CLI command rides: Composer's mapping when the
 * install is present, otherwise the zero-dependency spelling -- the same
 * mapping composer.json itself declares, spelled by hand: the framework's
 * runtime tree, the PSR contract trees it type-checks against, the
 * files-include bootstrap that publishes ZEF_FRAMEWORK_ROOT, and the
 * tooling support classes under tests/ (the gate engine's home since the
 * src tree became runtime-only code), so a bare install still loads all
 * of them.
 *
 * Extracted from nine per-command copies that had drifted from one pasted
 * block (#717): the loading strategy now changes in exactly one place,
 * while every command branch keeps its own argument validation ahead of
 * the call, exactly where each copy used to stand.
 */
function requireFrameworkAutoloader(): void
{
    $autoload = dirname(__DIR__) . '/vendor/autoload.php';
    if (is_file($autoload)) {
        require_once $autoload;

        return;
    }

    // The fallback mirrors composer.json exactly -- measured: the pasted
    // original mapped `Zef\Framework\` to `src/`, a path no framework
    // class has ever lived at, so the fallback had been unable to load a
    // single framework class since its birth in `fdb0f46`, uncaught
    // because no test exercises a vendor-less tree.
    require_once dirname(__DIR__) . '/src/autoload.php';

    spl_autoload_register(static function (string $class): void {
        $bases = [
            'Zef\\Framework\\' => dirname(__DIR__) . '/src/Zef/Framework/',
            'Psr\\Container\\' => dirname(__DIR__) . '/src/Contracts/Psr/Container/',
            'Psr\\Http\\Message\\' => dirname(__DIR__) . '/src/Contracts/Psr/Http/Message/',
            'Psr\\Http\\Server\\' => dirname(__DIR__) . '/src/Contracts/Psr/Http/Server/',
            'Psr\\Log\\' => dirname(__DIR__) . '/src/Contracts/Psr/Log/',
            'Zef\\Test\\' => dirname(__DIR__) . '/tests/',
        ];
        foreach ($bases as $prefix => $base) {
            if (str_starts_with($class, $prefix)) {
                $file = $base
                    . str_replace('\\', '/', substr($class, strlen($prefix))) . '.php';
                if (is_file($file)) {
                    require $file;
                }
            }
        }
    });
}

$command = $argv[1] ?? '';

if ($command === 'errors:replay') {
    requireFrameworkAutoloader();

    $outcome = \Zef\Test\Support\Tooling\ErrorsReplay::run(array_slice($argv, 2));
    fwrite(STDERR, $outcome->stderr);
    fwrite(STDOUT, $outcome->stdout);
    exit($outcome->exitCode);
}

if ($command === 'container:inventory') {
    requireFrameworkAutoloader();

    $outcome = \Zef\Test\Support\Tooling\ContainerInventory::run(array_slice($argv, 2));
    fwrite(STDERR, $outcome->stderr);
    fwrite(STDOUT, $outcome->stdout);
    exit($outcome->exitCode);
}

if (in_array($command, ['route:list', 'route:test', 'route:tree'], true)) {
    requireFrameworkAutoloader();

    $outcome = \Zef\Test\Support\Tooling\RouteInspection::run($command, array_slice($argv, 2));
    fwrite(STDERR, $outcome->stderr);
    fwrite(STDOUT, $outcome->stdout);
    exit($outcome->exitCode);
}

if (in_array($command, ['route:openapi', 'route:postman'], true)) {
    requireFrameworkAutoloader();

    $outcome = \Zef\Test\Support\Tooling\RouteExport::run($command, array_slice($argv, 2));
    fwrite(STDERR, $outcome->stderr);
    fwrite(STDOUT, $outcome->stdout);
    exit($outcome->exitCode);
}

if ($command === 'list') {
    requireFrameworkAutoloader();

    $outcome = \Zef\Test\Support\Tooling\CliList::run(array_slice($argv, 2));
    fwrite(STDERR, $outcome->stderr);
    fwrite(STDOUT, $outcome->stdout);
    exit($outcome->exitCode);
}

if ($command === 'storage:map') {
    requireFrameworkAutoloader();

    $outcome = \Zef\Test\Support\Tooling\StorageMap::run(array_slice($argv, 2));
    fwrite(STDERR, $outcome->stderr);
    fwrite(STDOUT, $outcome->stdout);
    exit($outcome->exitCode);
}

if (in_array($command, ['migrations:status', 'migrations:run', 'migrations:rollback', 'migrations:generate'], true)) {
    requireFrameworkAutoloader();

    $outcome = \Zef\Test\Support\Tooling\Migrations::run($command, array_slice($argv, 2));
    fwrite(STDERR, $outcome->stderr);
    fwrite(STDOUT, $outcome->stdout);
    exit($outcome->exitCode);
}

if (in_array($command, ['http:dump', 'http:headers'], true)) {
    $httpUsage = "Usage: bin/zef http:dump <config-directory> <method> <path>"
        . " [--host=<host>] [--scheme=http|https] [--header=<Name: Value>]... [--body=<text>]\n"
        . "       bin/zef http:headers <config-directory> <method> <path>"
        . " [--host=<host>] [--scheme=http|https] [--header=<Name: Value>]... [--body=<text>] [--json]\n";

    $configDirectoryArgument = $argv[2] ?? '';
    $method = $argv[3] ?? '';
    $path = $argv[4] ?? '';

    if ($configDirectoryArgument === '' || str_starts_with($configDirectoryArgument, '--')) {
        fwrite(STDERR, $httpUsage);
        exit(2);
    }

    $resolvedConfigDirectory = realpath($configDirectoryArgument);
    if ($resolvedConfigDirectory === false || !is_dir($resolvedConfigDirectory)) {
        fwrite(STDERR, "Configuration directory does not exist: {$configDirectoryArgument}\n");
        exit(2);
    }

    if (preg_match('/^[!#$%&\'*+.^_`|~0-9A-Za-z-]{1,32}$/D', $method) !== 1) {
        fwrite(STDERR, "Invalid request method: {$method}\n");
        exit(2);
    }

    if ($path === '' || !str_starts_with($path, '/') || strlen($path) > 2048
        || preg_match('/[\x00-\x1f\x7f]/', $path) === 1) {
        fwrite(STDERR, "The request path must start with a slash and carry no control bytes.\n");
        exit(2);
    }

    $host = 'localhost';
    $scheme = 'http';
    $headerArguments = [];
    $body = '';
    $asJson = false;

    foreach (array_slice($argv, 5) as $argument) {
        if (str_starts_with($argument, '--host=')) {
            $host = substr($argument, strlen('--host='));
        } elseif (str_starts_with($argument, '--scheme=')) {
            $scheme = substr($argument, strlen('--scheme='));
        } elseif (str_starts_with($argument, '--header=')) {
            $headerArguments[] = substr($argument, strlen('--header='));
        } elseif (str_starts_with($argument, '--body=')) {
            $body = substr($argument, strlen('--body='));
        } elseif ($argument === '--json' && $command === 'http:headers') {
            $asJson = true;
        } else {
            fwrite(STDERR, $httpUsage);
            exit(2);
        }
    }

    if ($host === '' || strlen($host) > 253 || preg_match('/[\x00-\x1f\x7f]/', $host) === 1) {
        fwrite(STDERR, "Invalid --host= value.\n");
        exit(2);
    }

    if (!in_array($scheme, ['http', 'https'], true)) {
        fwrite(STDERR, "The --scheme= flag accepts http or https.\n");
        exit(2);
    }

    if (count($headerArguments) > 16) {
        fwrite(STDERR, "At most 16 --header= flags are accepted.\n");
        exit(2);
    }

    $headerPairs = [];
    foreach ($headerArguments as $headerArgument) {
        $colon = strpos($headerArgument, ':');
        $headerName = $colon === false ? '' : substr($headerArgument, 0, $colon);
        $headerValue = $colon === false ? '' : ltrim(substr($headerArgument, $colon + 1), ' ');

        if (preg_match('/^[!#$%&\'*+.^_`|~0-9A-Za-z-]+$/D', $headerName) !== 1
            || $headerValue === ''
            || strlen($headerValue) > 4096
            || preg_match('/[\x00-\x08\x0a-\x1f\x7f]/', $headerValue) === 1) {
            fwrite(STDERR, "Each --header= flag must spell `Name: value`"
                . " with a printable value of at most 4096 bytes.\n");
            exit(2);
        }

        $headerPairs[] = [$headerName, $headerValue];
    }

    if (strlen($body) > 8192) {
        fwrite(STDERR, "The --body= flag accepts at most 8192 bytes.\n");
        exit(2);
    }

    requireFrameworkAutoloader();

    try {
        $exchange = Zef\Test\Support\Tooling\HttpInspectionBoot::answered(
            $resolvedConfigDirectory,
            $method,
            $path,
            $host,
            $scheme,
            $headerPairs,
            $body,
        );

        if ($command === 'http:dump') {
            fwrite(STDOUT, Zef\Test\Support\Tooling\HttpDumpText::rendered($exchange));
            exit(0);
        }

        $audit = Zef\Framework\Http\SecurityHeaderAudit::over(
            $exchange->response,
            $exchange->scheme(),
        );

        fwrite(
            STDOUT,
            $asJson
                ? Zef\Test\Support\Tooling\HeaderAuditJson::rendered($audit) . "\n"
                : Zef\Test\Support\Tooling\HeaderAuditText::table($audit),
        );
        exit($audit->passed() ? 0 : 1);
    } catch (Throwable $inspectionFailure) {
        fwrite(STDERR, 'The HTTP inspection refused: ' . $inspectionFailure->getMessage() . "\n");
        exit(1);
    }
}

// The declared-command dispatch: a verb none of the framework's own
// branches answered may be one the host or an active module declared --
// `bin/zef <command> <config-directory> [args...]`, the same
// config-directory-first grammar every composition command carries. A
// framework verb never dispatches through the registry: the CLI's own
// branches own the framework's verbs (the positional-path commands
// among them, which this seam must not intercept), and the registry
// itself refuses a declaration that collides with one. The dispatch
// resolves the ONE handler the operator's verb declared through the
// booted container, fail-closed, and passes the handler's own exit code
// through verbatim: the framework owns the boot and the resolution, the
// handler owns everything after.
$dispatchConfigDirectory = $argv[2] ?? '';

if ($command !== '' && $dispatchConfigDirectory !== '' && !str_starts_with($dispatchConfigDirectory, '--')) {
    requireFrameworkAutoloader();

    if (!isset(Zef\Framework\Console\FrameworkVerbs::all()[$command])) {
        $resolved = realpath($dispatchConfigDirectory);
        if ($resolved === false || !is_dir($resolved)) {
            fwrite(STDERR, "Configuration directory does not exist: {$dispatchConfigDirectory}\n");
            exit(2);
        }

        try {
            $kernel = Zef\Test\Support\Tooling\CliInspectionBoot::kernel($resolved);
            $commands = Zef\Framework\ConsoleWiring::commands($kernel->config());

            $entry = $commands->named($command);

            if ($entry === null) {
                fwrite(
                    STDERR,
                    "Unknown command '{$command}'. Run 'bin/zef list <config-directory>' to see the declared commands.\n",
                );
                exit(2);
            }

            $handler = Zef\Framework\ConsoleWiring::handler($kernel->container(), $entry);

            exit($handler->run(array_values(array_slice($argv, 3))));
        } catch (Throwable $dispatchFailure) {
            fwrite(STDERR, 'The command dispatch refused: ' . $dispatchFailure->getMessage() . "\n");
            exit(1);
        }
    }
}

if ($command === 'errors:report' || $command === 'errors:clear') {
    requireFrameworkAutoloader();

    if ($command === 'errors:clear') {
        $outcome = \Zef\Test\Support\Tooling\ErrorsClear::run(array_slice($argv, 2));
    } else {
        $outcome = \Zef\Test\Support\Tooling\ErrorsReport::run(array_slice($argv, 2));
    }

    fwrite(STDERR, $outcome->stderr);
    fwrite(STDOUT, $outcome->stdout);
    exit($outcome->exitCode);
}
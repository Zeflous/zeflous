#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * The one autoloader every CLI command rides: Composer's mapping when the
 * install is present, otherwise the zero-dependency spelling -- the same
 * mapping composer.json itself declares, spelled by hand: the framework's
 * runtime tree, the PSR contract trees it type-checks against, the
 * files-include bootstrap that publishes ZEF_FRAMEWORK_ROOT, and the
 * tooling support classes under tests/ (the gate engine's home since the
 * src tree became runtime-only code), so a bare install still loads all
 * of them.
 *
 * Extracted from nine per-command copies that had drifted from one pasted
 * block (#717): the loading strategy now changes in exactly one place,
 * while every command branch keeps its own argument validation ahead of
 * the call, exactly where each copy used to stand.
 */
function requireFrameworkAutoloader(): void
{
    $autoload = dirname(__DIR__) . '/vendor/autoload.php';
    if (is_file($autoload)) {
        require_once $autoload;

        return;
    }

    // The fallback mirrors composer.json exactly -- measured: the pasted
    // original mapped `Zef\Framework\` to `src/`, a path no framework
    // class has ever lived at, so the fallback had been unable to load a
    // single framework class since its birth in `fdb0f46`, uncaught
    // because no test exercises a vendor-less tree.
    require_once dirname(__DIR__) . '/src/autoload.php';

    spl_autoload_register(static function (string $class): void {
        $bases = [
            'Zef\\Framework\\' => dirname(__DIR__) . '/src/Zef/Framework/',
            'Psr\\Container\\' => dirname(__DIR__) . '/src/Contracts/Psr/Container/',
            'Psr\\Http\\Message\\' => dirname(__DIR__) . '/src/Contracts/Psr/Http/Message/',
            'Psr\\Http\\Server\\' => dirname(__DIR__) . '/src/Contracts/Psr/Http/Server/',
            'Psr\\Log\\' => dirname(__DIR__) . '/src/Contracts/Psr/Log/',
            'Zef\\Test\\' => dirname(__DIR__) . '/tests/',
        ];
        foreach ($bases as $prefix => $base) {
            if (str_starts_with($class, $prefix)) {
                $file = $base
                    . str_replace('\\', '/', substr($class, strlen($prefix))) . '.php';
                if (is_file($file)) {
                    require $file;
                }
            }
        }
    });
}

$command = $argv[1] ?? '';

if ($command === 'errors:replay') {
    requireFrameworkAutoloader();

    $outcome = \Zef\Test\Support\Tooling\ErrorsReplay::run(array_slice($argv, 2));
    fwrite(STDERR, $outcome->stderr);
    fwrite(STDOUT, $outcome->stdout);
    exit($outcome->exitCode);
}

if ($command === 'container:inventory') {
    requireFrameworkAutoloader();

    $outcome = \Zef\Test\Support\Tooling\ContainerInventory::run(array_slice($argv, 2));
    fwrite(STDERR, $outcome->stderr);
    fwrite(STDOUT, $outcome->stdout);
    exit($outcome->exitCode);
}

if (in_array($command, ['route:list', 'route:test', 'route:tree'], true)) {
    $routeUsage = "Usage: bin/zef route:list <config-directory> [--json]\n"
        . "       bin/zef route:test <config-directory> <method> <path>"
        . " [--host=<host>] [--accept=<value>] [--version=<value>] [--json]\n"
        . "       bin/zef route:tree <config-directory>\n";

    $configDirectory = $argv[2] ?? '';

    if ($configDirectory === '' || str_starts_with($configDirectory, '--')) {
        fwrite(STDERR, $routeUsage);
        exit(2);
    }

    $resolved = realpath($configDirectory);
    if ($resolved === false || !is_dir($resolved)) {
        fwrite(STDERR, "Configuration directory does not exist: {$configDirectory}\n");
        exit(2);
    }

    $method = null;
    $path = null;
    $host = null;
    $accept = null;
    $version = null;
    $asJson = false;

    if ($command === 'route:test') {
        $method = $argv[3] ?? '';
        $path = $argv[4] ?? '';

        if (preg_match('/^[!#$%&\'*+.^_`|~0-9A-Za-z-]{1,32}$/D', $method) !== 1) {
            fwrite(STDERR, "Invalid request method: {$method}\n");
            exit(2);
        }

        if ($path === '' || !str_starts_with($path, '/') || strlen($path) > 2048
            || preg_match('/[\x00-\x1f\x7f]/', $path) === 1) {
            fwrite(STDERR, "The request path must start with a slash and carry no control bytes.\n");
            exit(2);
        }
    }

    $flagOffset = $command === 'route:test' ? 5 : 3;
    $routeFlags = [];

    foreach (array_slice($argv, $flagOffset) as $argument) {
        if (str_starts_with($argument, '--json')) {
            $routeFlags[] = $argument;
        } elseif ($command === 'route:test' && str_starts_with($argument, '--host=')) {
            $host = substr($argument, strlen('--host='));
        } elseif ($command === 'route:test' && str_starts_with($argument, '--accept=')) {
            $accept = substr($argument, strlen('--accept='));
        } elseif ($command === 'route:test' && str_starts_with($argument, '--version=')) {
            $version = substr($argument, strlen('--version='));
        } else {
            fwrite(STDERR, $routeUsage);
            exit(2);
        }
    }

    foreach ($routeFlags as $routeFlag) {
        if ($routeFlag === '--json' && $command !== 'route:tree') {
            $asJson = true;
        } else {
            fwrite(STDERR, $routeUsage);
            exit(2);
        }
    }

    if ($command === 'route:test') {
        foreach ([['--host=', $host, 253], ['--accept=', $accept, 256], ['--version=', $version, 256]] as $bound) {
            [$flagName, $value, $limit] = $bound;
            if ($value !== null
                && ($value === '' || strlen($value) > $limit || preg_match('/[\x00-\x1f\x7f]/', $value) === 1)) {
                fwrite(STDERR, "Invalid {$flagName} value.\n");
                exit(2);
            }
        }
    }

    requireFrameworkAutoloader();

    try {
        $router = Zef\Test\Support\Tooling\RouteInspectionBoot::router($resolved);

        if ($command === 'route:list') {
            fwrite(
                STDOUT,
                $asJson
                    ? Zef\Test\Support\Tooling\RouteListJson::rendered($router) . "\n"
                    : Zef\Test\Support\Tooling\RouteListText::table($router),
            );
            exit(0);
        }

        if ($command === 'route:tree') {
            fwrite(STDOUT, Zef\Test\Support\Tooling\RouteTreeText::rendered($router));
            exit(0);
        }

        $answer = Zef\Test\Support\Tooling\RouteMatchAnswer::answered(
            $router,
            $method,
            $path,
            $host,
            $accept,
            $version,
        );

        fwrite(
            STDOUT,
            $asJson
                ? Zef\Test\Support\Tooling\RouteMatchJson::rendered($answer) . "\n"
                : Zef\Test\Support\Tooling\RouteMatchText::rendered($answer),
        );
        exit($answer->outcome === Zef\Framework\Config\Routing\RouteMatchExplanation::OUTCOME_FOUND ? 0 : 1);
    } catch (Throwable $bootFailure) {
        fwrite(STDERR, 'The route boot refused: ' . $bootFailure->getMessage() . "\n");
        exit(1);
    }
}

if (in_array($command, ['route:openapi', 'route:postman'], true)) {
    $exportUsage = "Usage: bin/zef route:openapi <config-directory> --title=<title> --version=<api-version>"
        . " [--scheme=http|https]\n"
        . "       bin/zef route:postman <config-directory> --title=<title>\n";

    $configDirectory = $argv[2] ?? '';

    if ($configDirectory === '' || str_starts_with($configDirectory, '--')) {
        fwrite(STDERR, $exportUsage);
        exit(2);
    }

    $resolved = realpath($configDirectory);
    if ($resolved === false || !is_dir($resolved)) {
        fwrite(STDERR, "Configuration directory does not exist: {$configDirectory}\n");
        exit(2);
    }

    $exportTitle = null;
    $exportVersion = null;
    $exportScheme = 'https';

    foreach (array_slice($argv, 3) as $argument) {
        if (str_starts_with($argument, '--title=')) {
            $exportTitle = substr($argument, strlen('--title='));
        } elseif ($command === 'route:openapi' && str_starts_with($argument, '--version=')) {
            $exportVersion = substr($argument, strlen('--version='));
        } elseif ($command === 'route:openapi' && str_starts_with($argument, '--scheme=')) {
            $exportScheme = substr($argument, strlen('--scheme='));
        } else {
            fwrite(STDERR, $exportUsage);
            exit(2);
        }
    }

    $requiredFlags = [['--title=', $exportTitle]];
    if ($command === 'route:openapi') {
        $requiredFlags[] = ['--version=', $exportVersion];
    }

    foreach ($requiredFlags as $bound) {
        [$flagName, $value] = $bound;
        if ($value === null
            || $value === ''
            || strlen($value) > 256
            || preg_match('/[\x00-\x1f\x7f]/', $value) === 1) {
            fwrite(STDERR, "Invalid {$flagName} value.\n");
            fwrite(STDERR, $exportUsage);
            exit(2);
        }
    }

    if (!in_array($exportScheme, ['http', 'https'], true)) {
        fwrite(STDERR, "Invalid --scheme= value.\n");
        fwrite(STDERR, $exportUsage);
        exit(2);
    }

    requireFrameworkAutoloader();

    try {
        $router = Zef\Test\Support\Tooling\RouteInspectionBoot::router($resolved);

        if ($command === 'route:openapi') {
            fwrite(
                STDOUT,
                Zef\Test\Support\Tooling\RouteOpenApiExport::rendered(
                    $router,
                    $exportTitle,
                    $exportVersion,
                    $exportScheme,
                ) . "\n",
            );
            exit(0);
        }

        fwrite(
            STDOUT,
            Zef\Test\Support\Tooling\RoutePostmanExport::rendered($router, $exportTitle) . "\n",
        );
        exit(0);
    } catch (Throwable $bootFailure) {
        fwrite(STDERR, 'The export refused: ' . $bootFailure->getMessage() . "\n");
        exit(1);
    }
}

if ($command === 'list') {
    requireFrameworkAutoloader();

    $outcome = \Zef\Test\Support\Tooling\CliList::run(array_slice($argv, 2));
    fwrite(STDERR, $outcome->stderr);
    fwrite(STDOUT, $outcome->stdout);
    exit($outcome->exitCode);
}

if ($command === 'storage:map') {
    $storageUsage = "Usage: bin/zef storage:map [<storage-root>] [--json]\n";

    $storageRootArgument = null;
    $storageAsJson = false;

    foreach (array_slice($argv, 2) as $argument) {
        if ($argument === '--json') {
            $storageAsJson = true;
        } elseif (str_starts_with($argument, '--')) {
            fwrite(STDERR, $storageUsage);
            exit(2);
        } elseif ($storageRootArgument === null) {
            $storageRootArgument = $argument;
        } else {
            fwrite(STDERR, $storageUsage);
            exit(2);
        }
    }

    $environmentRoot = getenv('ZEF_STORAGE_ROOT');
    $storageRoot = $storageRootArgument ?? (
        \is_string($environmentRoot) && $environmentRoot !== ''
            ? $environmentRoot
            : dirname(__DIR__) . '/files'
    );

    requireFrameworkAutoloader();

    try {
        $storagePaths = Zef\Framework\Storage\StorageLayout::resolve($storageRoot);

        fwrite(
            STDOUT,
            $storageAsJson
                ? Zef\Test\Support\Tooling\StorageMapJson::rendered($storagePaths) . "\n"
                : Zef\Test\Support\Tooling\StorageMapText::table($storagePaths),
        );
        exit(0);
    } catch (Throwable $layoutFailure) {
        fwrite(STDERR, 'The storage layout refused: ' . $layoutFailure->getMessage() . "\n");
        exit(1);
    }
}

if (in_array($command, ['migrations:status', 'migrations:run', 'migrations:rollback', 'migrations:generate'], true)) {
    $migrationsUsage = "Usage: bin/zef migrations:status <config-directory>"
        . " [<migrations-directory>] [--json]\n"
        . "       bin/zef migrations:run <config-directory>"
        . " [<migrations-directory>] [--json]\n"
        . "       bin/zef migrations:rollback <config-directory>"
        . " [<migrations-directory>] [--steps=<n>] [--json]\n"
        . "       bin/zef migrations:generate <config-directory>"
        . " [<migrations-directory>] <name> [--json]\n"
        . "       (the migrations directory defaults to the configuration"
        . " directory's sibling 'migrations')\n";

    $configDirectoryArgument = $argv[2] ?? '';
    $migrationsDirectoryArgument = null;
    $generateNameArgument = null;
    $answerAsJson = false;
    $rollbackSteps = 1;

    if ($configDirectoryArgument === '' || str_starts_with($configDirectoryArgument, '--')) {
        fwrite(STDERR, $migrationsUsage);
        exit(2);
    }

    $positionalArguments = [];

    foreach (array_slice($argv, 3) as $argument) {
        if ($argument === '--json'
            && in_array($command, ['migrations:status', 'migrations:run', 'migrations:rollback', 'migrations:generate'], true)
        ) {
            $answerAsJson = true;
        } elseif (str_starts_with($argument, '--steps=') && $command === 'migrations:rollback') {
            $steps = substr($argument, strlen('--steps='));
            if (preg_match('/^[1-9][0-9]{0,8}$/', $steps) !== 1) {
                fwrite(STDERR, $migrationsUsage);
                exit(2);
            }
            $rollbackSteps = (int) $steps;
        } elseif (str_starts_with($argument, '--')) {
            fwrite(STDERR, $migrationsUsage);
            exit(2);
        } else {
            $positionalArguments[] = $argument;
        }
    }

    if ($command === 'migrations:generate') {
        if (count($positionalArguments) === 2) {
            [$migrationsDirectoryArgument, $generateNameArgument] = $positionalArguments;
        } elseif (count($positionalArguments) === 1) {
            $generateNameArgument = $positionalArguments[0];
        } else {
            fwrite(STDERR, $migrationsUsage);
            exit(2);
        }
    } elseif ($positionalArguments !== []) {
        if (count($positionalArguments) > 1) {
            fwrite(STDERR, $migrationsUsage);
            exit(2);
        }

        $migrationsDirectoryArgument = $positionalArguments[0];
    }

    $resolvedConfigDirectory = realpath($configDirectoryArgument);
    if ($resolvedConfigDirectory === false || !is_dir($resolvedConfigDirectory)) {
        fwrite(STDERR, "Configuration directory does not exist: {$configDirectoryArgument}\n");
        exit(2);
    }

    $migrationsDirectory = $migrationsDirectoryArgument
        ?? dirname($resolvedConfigDirectory) . '/migrations';

    requireFrameworkAutoloader();

    if ($command === 'migrations:generate') {
        $generateVersionStamp = (new DateTimeImmutable('now', new DateTimeZone('UTC')))->format('YmdHis');

        try {
            $generated = Zef\Test\Support\Tooling\MigrationsGenerate::written(
                $migrationsDirectory,
                $generateNameArgument,
                $generateVersionStamp,
            );

            fwrite(
                STDOUT,
                $answerAsJson
                    ? Zef\Test\Support\Tooling\MigrationsGenerateJson::rendered(
                        $generated['version'],
                        $generated['name'],
                        $generated['file'],
                    ) . "\n"
                    : Zef\Test\Support\Tooling\MigrationsGenerateText::created($generated['file']),
            );
            exit(0);
        } catch (InvalidArgumentException $generateUsageDefect) {
            fwrite(STDERR, $migrationsUsage);
            exit(2);
        } catch (Throwable $generateFailure) {
            fwrite(STDERR, 'The migrations command refused: ' . $generateFailure->getMessage() . "\n");
            exit(1);
        }
    }

    try {
        $migrationsBoot = Zef\Test\Support\Tooling\MigrationsBoot::booted(
            $resolvedConfigDirectory,
            $migrationsDirectory,
        );

        if ($command === 'migrations:status') {
            fwrite(
                STDOUT,
                $answerAsJson
                    ? Zef\Test\Support\Tooling\MigrationsStatusJson::rendered(
                        $migrationsBoot->names(),
                        $migrationsBoot->applied(),
                        $migrationsBoot->plan(),
                    ) . "\n"
                    : Zef\Test\Support\Tooling\MigrationsStatusText::table(
                        $migrationsBoot->names(),
                        $migrationsBoot->applied(),
                        $migrationsBoot->plan(),
                    ),
            );
        } elseif ($command === 'migrations:run') {
            fwrite(
                STDOUT,
                $answerAsJson
                    ? Zef\Test\Support\Tooling\MigrationsRunJson::applied(
                        $migrationsBoot->names(),
                        $migrationsBoot->migrate(),
                    ) . "\n"
                    : Zef\Test\Support\Tooling\MigrationsRunText::applied(
                        $migrationsBoot->names(),
                        $migrationsBoot->migrate(),
                    ),
            );
        } else {
            fwrite(
                STDOUT,
                $answerAsJson
                    ? Zef\Test\Support\Tooling\MigrationsRollbackJson::rolledBack(
                        $migrationsBoot->names(),
                        $migrationsBoot->rollback($rollbackSteps),
                    ) . "\n"
                    : Zef\Test\Support\Tooling\MigrationsRunText::rolledBack(
                        $migrationsBoot->names(),
                        $migrationsBoot->rollback($rollbackSteps),
                    ),
            );
        }

        exit(0);
    } catch (Throwable $migrationsFailure) {
        fwrite(STDERR, 'The migrations command refused: ' . $migrationsFailure->getMessage() . "\n");
        exit(1);
    }
}

if (in_array($command, ['http:dump', 'http:headers'], true)) {
    $httpUsage = "Usage: bin/zef http:dump <config-directory> <method> <path>"
        . " [--host=<host>] [--scheme=http|https] [--header=<Name: Value>]... [--body=<text>]\n"
        . "       bin/zef http:headers <config-directory> <method> <path>"
        . " [--host=<host>] [--scheme=http|https] [--header=<Name: Value>]... [--body=<text>] [--json]\n";

    $configDirectoryArgument = $argv[2] ?? '';
    $method = $argv[3] ?? '';
    $path = $argv[4] ?? '';

    if ($configDirectoryArgument === '' || str_starts_with($configDirectoryArgument, '--')) {
        fwrite(STDERR, $httpUsage);
        exit(2);
    }

    $resolvedConfigDirectory = realpath($configDirectoryArgument);
    if ($resolvedConfigDirectory === false || !is_dir($resolvedConfigDirectory)) {
        fwrite(STDERR, "Configuration directory does not exist: {$configDirectoryArgument}\n");
        exit(2);
    }

    if (preg_match('/^[!#$%&\'*+.^_`|~0-9A-Za-z-]{1,32}$/D', $method) !== 1) {
        fwrite(STDERR, "Invalid request method: {$method}\n");
        exit(2);
    }

    if ($path === '' || !str_starts_with($path, '/') || strlen($path) > 2048
        || preg_match('/[\x00-\x1f\x7f]/', $path) === 1) {
        fwrite(STDERR, "The request path must start with a slash and carry no control bytes.\n");
        exit(2);
    }

    $host = 'localhost';
    $scheme = 'http';
    $headerArguments = [];
    $body = '';
    $asJson = false;

    foreach (array_slice($argv, 5) as $argument) {
        if (str_starts_with($argument, '--host=')) {
            $host = substr($argument, strlen('--host='));
        } elseif (str_starts_with($argument, '--scheme=')) {
            $scheme = substr($argument, strlen('--scheme='));
        } elseif (str_starts_with($argument, '--header=')) {
            $headerArguments[] = substr($argument, strlen('--header='));
        } elseif (str_starts_with($argument, '--body=')) {
            $body = substr($argument, strlen('--body='));
        } elseif ($argument === '--json' && $command === 'http:headers') {
            $asJson = true;
        } else {
            fwrite(STDERR, $httpUsage);
            exit(2);
        }
    }

    if ($host === '' || strlen($host) > 253 || preg_match('/[\x00-\x1f\x7f]/', $host) === 1) {
        fwrite(STDERR, "Invalid --host= value.\n");
        exit(2);
    }

    if (!in_array($scheme, ['http', 'https'], true)) {
        fwrite(STDERR, "The --scheme= flag accepts http or https.\n");
        exit(2);
    }

    if (count($headerArguments) > 16) {
        fwrite(STDERR, "At most 16 --header= flags are accepted.\n");
        exit(2);
    }

    $headerPairs = [];
    foreach ($headerArguments as $headerArgument) {
        $colon = strpos($headerArgument, ':');
        $headerName = $colon === false ? '' : substr($headerArgument, 0, $colon);
        $headerValue = $colon === false ? '' : ltrim(substr($headerArgument, $colon + 1), ' ');

        if (preg_match('/^[!#$%&\'*+.^_`|~0-9A-Za-z-]+$/D', $headerName) !== 1
            || $headerValue === ''
            || strlen($headerValue) > 4096
            || preg_match('/[\x00-\x08\x0a-\x1f\x7f]/', $headerValue) === 1) {
            fwrite(STDERR, "Each --header= flag must spell `Name: value`"
                . " with a printable value of at most 4096 bytes.\n");
            exit(2);
        }

        $headerPairs[] = [$headerName, $headerValue];
    }

    if (strlen($body) > 8192) {
        fwrite(STDERR, "The --body= flag accepts at most 8192 bytes.\n");
        exit(2);
    }

    requireFrameworkAutoloader();

    try {
        $exchange = Zef\Test\Support\Tooling\HttpInspectionBoot::answered(
            $resolvedConfigDirectory,
            $method,
            $path,
            $host,
            $scheme,
            $headerPairs,
            $body,
        );

        if ($command === 'http:dump') {
            fwrite(STDOUT, Zef\Test\Support\Tooling\HttpDumpText::rendered($exchange));
            exit(0);
        }

        $audit = Zef\Framework\Http\SecurityHeaderAudit::over(
            $exchange->response,
            $exchange->scheme(),
        );

        fwrite(
            STDOUT,
            $asJson
                ? Zef\Test\Support\Tooling\HeaderAuditJson::rendered($audit) . "\n"
                : Zef\Test\Support\Tooling\HeaderAuditText::table($audit),
        );
        exit($audit->passed() ? 0 : 1);
    } catch (Throwable $inspectionFailure) {
        fwrite(STDERR, 'The HTTP inspection refused: ' . $inspectionFailure->getMessage() . "\n");
        exit(1);
    }
}

// The declared-command dispatch: a verb none of the framework's own
// branches answered may be one the host or an active module declared --
// `bin/zef <command> <config-directory> [args...]`, the same
// config-directory-first grammar every composition command carries. A
// framework verb never dispatches through the registry: the CLI's own
// branches own the framework's verbs (the positional-path commands
// among them, which this seam must not intercept), and the registry
// itself refuses a declaration that collides with one. The dispatch
// resolves the ONE handler the operator's verb declared through the
// booted container, fail-closed, and passes the handler's own exit code
// through verbatim: the framework owns the boot and the resolution, the
// handler owns everything after.
$dispatchConfigDirectory = $argv[2] ?? '';

if ($command !== '' && $dispatchConfigDirectory !== '' && !str_starts_with($dispatchConfigDirectory, '--')) {
    requireFrameworkAutoloader();

    if (!isset(Zef\Framework\Console\FrameworkVerbs::all()[$command])) {
        $resolved = realpath($dispatchConfigDirectory);
        if ($resolved === false || !is_dir($resolved)) {
            fwrite(STDERR, "Configuration directory does not exist: {$dispatchConfigDirectory}\n");
            exit(2);
        }

        try {
            $kernel = Zef\Test\Support\Tooling\CliInspectionBoot::kernel($resolved);
            $commands = Zef\Framework\ConsoleWiring::commands($kernel->config());

            $entry = $commands->named($command);

            if ($entry === null) {
                fwrite(
                    STDERR,
                    "Unknown command '{$command}'. Run 'bin/zef list <config-directory>' to see the declared commands.\n",
                );
                exit(2);
            }

            $handler = Zef\Framework\ConsoleWiring::handler($kernel->container(), $entry);

            exit($handler->run(array_values(array_slice($argv, 3))));
        } catch (Throwable $dispatchFailure) {
            fwrite(STDERR, 'The command dispatch refused: ' . $dispatchFailure->getMessage() . "\n");
            exit(1);
        }
    }
}

if ($command === 'errors:report' || $command === 'errors:clear') {
    requireFrameworkAutoloader();

    if ($command === 'errors:clear') {
        $outcome = \Zef\Test\Support\Tooling\ErrorsClear::run(array_slice($argv, 2));
    } else {
        $outcome = \Zef\Test\Support\Tooling\ErrorsReport::run(array_slice($argv, 2));
    }

    fwrite(STDERR, $outcome->stderr);
    fwrite(STDOUT, $outcome->stdout);
    exit($outcome->exitCode);
}
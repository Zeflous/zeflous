<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         executionOrder="defects"
         resolveDependencies="true"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnRisky="true"
         failOnWarning="true"
         beStrictAboutOutputDuringTests="true"
         beStrictAboutTestsThatDoNotTestAnything="true"
         requireCoverageMetadata="true"
         displayDetailsOnPhpunitDeprecations="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnTestsThatTriggerErrors="true"
         displayDetailsOnTestsThatTriggerNotices="true"
         displayDetailsOnTestsThatTriggerWarnings="true">
    <testsuites>
        <testsuite name="ZEF Framework">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
            <!-- The CI gate engine lives under tests/Support/Tooling (developer
                 tooling, not framework runtime code), but its correctness is
                 still gated by the same coverage threshold: the source include
                 carries it into the clover report so the coverage gate and
                 Infection keep measuring it at its new home, exactly as they
                 did from src/. -->
            <directory>tests/Support/Tooling</directory>
        </include>
        <exclude>
            <directory>src/Contracts/Psr</directory>
        </exclude>
    </source>
</phpunit>

{
    "name": "Zeflous/zeflous",
    "description": "ZEF Framework — hexagonal PHP 8.4 framework, zero-library shim, Radix Tree routing, RoadRunner-ready",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "mbetixz"
        }
    ],
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "code-lts/doctum": "^5.6",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2.17",
        "phpstan/phpstan-strict-rules": "^2.0",
        "squizlabs/php_codesniffer": "^4.0",
        "slevomat/coding-standard": "^8.31",
        "phpunit/phpunit": "^13",
        "rector/rector": "^2.6",
        "infection/infection": "^0.35",
        "phpbench/phpbench": "^1.4",
        "deptrac/deptrac": "^4.7"
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "audit": {
            "abandoned": "report"
        }
    },
    "autoload": {
        "psr-4": {
            "Zef\\Framework\\": "src/",
            "Psr\\Container\\": "src/Contracts/Psr/Container/",
            "Psr\\Log\\": "src/Contracts/Psr/Log/",
            "Psr\\Http\\Message\\": "src/Contracts/Psr/Http/Message/",
            "Psr\\Http\\Server\\": "src/Contracts/Psr/Http/Server/"
        },
        "files": [
            "src/autoload.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Zef\\Test\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "coverage": "phpunit --coverage-text",
        "coverage:gate": [
            "phpunit --coverage-clover build/clover.xml --coverage-text",
            "php scripts/ci/assert-coverage.php 90"
        ],
        "format": "php-cs-fixer fix --using-cache=no",
        "format:check": "php-cs-fixer check --diff --using-cache=no",
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "rector": "rector process",
        "rector:check": "rector process --dry-run --no-progress-bar",
        "stan": "phpstan analyse --configuration=phpstan.neon.dist --memory-limit=1G",
        "docs": "php vendor/bin/doctum.php update doctum.php --no-progress",
        "audit:security": "@php scripts/ci/assert-abandoned-policy.php",
        "deptrac": "deptrac analyse --config-file=deptrac.yaml --no-progress --fail-on-uncovered",
        "mutation": "infection --threads=max --min-msi=85 --min-covered-msi=90",
        "mutation:ci": "infection --threads=max --min-msi=85 --min-covered-msi=90 --logger-github",
        "mutation:zones": "php scripts/ci/assert-zone-coverage.php --floor=95",
        "stan:ratchet": "php scripts/ci/assert-phpstan-baseline.php",
        "bench": "phpbench run --report=aggregate --progress=none",
        "bench:regression": "phpbench run --report=aggregate --progress=none --assert=\"mode(variant.time.avg) < 50\" --assert=\"mode(variant.mem.peak) < 20000000\"",
        "smoke:persistent": "@php scripts/ci/persistent-smoke.php",
        "lint": "@php scripts/lint.php",
        "ci": [
            "@composer validate --strict",
            "@composer lint",
            "@composer stan",
            "@composer stan:ratchet",
            "@composer deptrac",
            "@composer format:check",
            "@composer phpcs",
            "@composer rector:check",
            "@composer test",
            "@composer smoke:persistent"
        ]
    },
    "keywords": [
        "php",
        "framework"
    ],
    "homepage": "https://github.com/Zeflous/zeflous",
    "support": {
        "issues": "https://github.com/Zeflous/zeflous/issues",
        "docs": "https://zeflous.github.io/zeflous/",
        "source": "https://github.com/Zeflous/zeflous"
    }
}

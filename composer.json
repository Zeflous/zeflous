{
    "name": "zeflous/zeflous",
    "description": "ZEF Framework - a hexagonal PHP 8.4 framework with a zero-library shim, Radix-Tree routing and a RoadRunner-ready persistent-worker runtime.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "php",
        "framework",
        "zef",
        "hexagonal",
        "roadrunner",
        "psr-11",
        "psr-15",
        "radix-tree"
    ],
    "homepage": "https://github.com/Zeflous/zeflous",
    "authors": [
        {
            "name": "mbetixz",
            "email": "mbetixz93@gmail.com",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/Zeflous/zeflous/issues",
        "source": "https://github.com/Zeflous/zeflous",
        "docs": "https://github.com/Zeflous/zeflous/blob/main/ROADMAP.md"
    },
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "code-lts/doctum": "^5.6",
        "deptrac/deptrac": "^4.7",
        "friendsofphp/php-cs-fixer": "^3.95",
        "infection/infection": "^0.35",
        "phpbench/phpbench": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^13.0",
        "rector/rector": "^2.6",
        "slevomat/coding-standard": "^8.31",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "suggest": {
        "ext-pcov": "Fast coverage driver required by Infection mutation testing and the coverage gate.",
        "ext-swoole": "Coroutine runtime adapter, an alternative to RoadRunner.",
        "spiral/roadrunner-worker": "Persistent-worker bridge used by the RoadRunner runtime adapter."
    },
    "autoload": {
        "psr-4": {
            "Zef\\Framework\\": "src/Zef/Framework/",
            "Psr\\Container\\": "src/Contracts/Psr/Container/",
            "Psr\\Http\\Message\\": "src/Contracts/Psr/Http/Message/",
            "Psr\\Http\\Server\\": "src/Contracts/Psr/Http/Server/",
            "Psr\\Log\\": "src/Contracts/Psr/Log/"
        },
        "files": [
            "src/autoload.php"
        ],
        "exclude-from-classmap": [
            "/vendor/psr/container/src/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Zef\\Test\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "infection/extension-installer": true
        },
        "audit": {
            "abandoned": "report"
        }
    },
    "scripts": {
        "test": "phpunit",
        "coverage": "phpunit --coverage-text",
        "coverage:gate": [
            "phpunit --coverage-clover build/clover.xml --coverage-text",
            "php scripts/ci/assert-coverage.php 90"
        ],
        "format": "php-cs-fixer fix --using-cache=no",
        "format:check": "php-cs-fixer check --diff --using-cache=no",
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "rector": "rector process",
        "rector:check": "rector process --dry-run --no-progress-bar",
        "stan": "phpstan analyse --configuration=phpstan.neon.dist --memory-limit=1G",
        "stan:ratchet": "php scripts/ci/assert-phpstan-baseline.php",
        "deptrac": "deptrac analyse --config-file=deptrac.yaml --no-progress",
        "audit:security": "@php scripts/ci/assert-abandoned-policy.php",
        "mutation": "infection --threads=max --min-msi=85 --min-covered-msi=90",
        "mutation:ci": "infection --threads=max --min-msi=85 --min-covered-msi=90 --logger-github",
        "mutation:zones": "php scripts/ci/assert-zone-coverage.php --floor=95",
        "docs": "php vendor/bin/doctum.php update doctum.php --no-progress",
        "bench": "phpbench run --report=aggregate --progress=none",
        "bench:regression": "phpbench run --report=aggregate --progress=none",
        "smoke:persistent": "@php scripts/ci/persistent-smoke.php",
        "lint": "@php scripts/lint.php",
        "ci": [
            "@composer validate --strict",
            "@composer lint",
            "@composer stan",
            "@composer stan:ratchet",
            "@composer deptrac",
            "@composer format:check",
            "@composer phpcs",
            "@composer rector:check",
            "@composer test",
            "@composer smoke:persistent"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit test suite.",
        "coverage": "Run PHPUnit with a text coverage report.",
        "coverage:gate": "Run PHPUnit coverage and enforce the 90% line-coverage gate.",
        "format": "Apply php-cs-fixer formatting.",
        "format:check": "Check formatting without modifying files.",
        "phpcs": "Run PHP_CodeSniffer with the Slevomat/PSR-12 ruleset.",
        "phpcbf": "Auto-fix PHP_CodeSniffer violations.",
        "rector": "Apply Rector refactorings.",
        "rector:check": "Dry-run Rector to detect needed refactorings.",
        "stan": "Run PHPStan static analysis.",
        "stan:ratchet": "Enforce the PHPStan baseline ratchet (no new errors).",
        "deptrac": "Run Deptrac architecture-boundary analysis.",
        "audit:security": "Assert the abandoned-package policy.",
        "mutation": "Run Infection mutation testing with MSI gates.",
        "mutation:ci": "Run Infection in CI mode with GitHub annotations.",
        "mutation:zones": "Enforce the per-zone mutation coverage floor.",
        "docs": "Build the API documentation with Doctum.",
        "bench": "Run the PHPBench benchmarks.",
        "bench:regression": "Run PHPBench with the aggregate report.",
        "smoke:persistent": "Run the persistent-worker (RoadRunner) smoke test.",
        "lint": "Fast syntax lint of the codebase.",
        "ci": "Full local CI pipeline (mirrors the GitHub Actions workflow)."
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

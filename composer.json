{
    "name": "zeflous/zeflous",
    "description": "ZEF Framework - a hexagonal PHP 8.4 framework with a zero-library shim, Radix-Tree routing and a RoadRunner-ready persistent-worker runtime.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "php",
        "framework",
        "zef",
        "hexagonal",
        "roadrunner",
        "psr-11",
        "psr-15",
        "radix-tree"
    ],
    "homepage": "https://github.com/Zeflous/zeflous",
    "authors": [
        {
            "name": "mbetixz",
            "email": "mbetixz93@gmail.com",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/Zeflous/zeflous/issues",
        "source": "https://github.com/Zeflous/zeflous",
        "docs": "https://github.com/Zeflous/zeflous/blob/main/ROADMAP.md"
    },
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "code-lts/doctum": "^5.6",
        "deptrac/deptrac": "^4.7",
        "friendsofphp/php-cs-fixer": "^3.95",
        "infection/infection": "^0.35",
        "php-code-archeology/php-code-archeology": "^2.11",
        "phpbench/phpbench": "^1.7",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpunit/phpunit": "^13.4",
        "rector/rector": "^2.7",
        "slevomat/coding-standard": "^8.31",
        "squizlabs/php_codesniffer": "^4.0",
        "vimeo/psalm": "^6.19"
    },
    "suggest": {
        "ext-pcov": "Fast coverage driver required by Infection mutation testing and the coverage gate.",
        "ext-swoole": "Coroutine runtime adapter, an alternative to RoadRunner.",
        "spiral/roadrunner-worker": "Persistent-worker bridge used by the RoadRunner runtime adapter."
    },
    "autoload": {
        "psr-4": {
            "Zef\\Framework\\": "src/Zef/Framework/",
            "Psr\\Container\\": "src/Contracts/Psr/Container/",
            "Psr\\Http\\Message\\": "src/Contracts/Psr/Http/Message/",
            "Psr\\Http\\Server\\": "src/Contracts/Psr/Http/Server/",
            "Psr\\Log\\": "src/Contracts/Psr/Log/"
        },
        "files": [
            "src/autoload.php"
        ],
        "exclude-from-classmap": [
            "/vendor/psr/container/src/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Zef\\Test\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "infection/extension-installer": true,
            "php-code-archeology/php-code-archeology": true,
            "phpstan/extension-installer": true
        },
        "audit": {
            "abandoned": "fail",
            "ignore": [
                "doctrine/annotations"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "coverage": "phpunit --coverage-text",
        "coverage:gate": [
            "@php -d pcov.enabled=1 vendor/bin/phpunit --coverage-clover build/clover.xml --coverage-text",
            "@php scripts/ci/gate.php coverage 90"
        ],
        "format": "php-cs-fixer fix --using-cache=no",
        "format:check": "php-cs-fixer check --diff --using-cache=no",
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "rector": "rector process",
        "rector:check": "rector process --dry-run --no-progress-bar",
        "stan": "phpstan analyse --configuration=phpstan.neon.dist --memory-limit=1G --no-progress",
        "stan:ratchet": "@php scripts/ci/gate.php baseline",
        "psalm": "psalm --no-cache --no-progress",
        "archeology": "phpcodearcheology --report-type=sarif,markdown --report-dir=build/archeology --no-color",
        "archeology:gate": "phpcodearcheology --quick --fail-on=error --no-color src",
        "deptrac": "deptrac analyse --config-file=deptrac.yaml --no-progress",
        "audit:security": "@php scripts/ci/gate.php audit",
        "audit:strict": "@php scripts/ci/gate.php audit",
        "mutation": "@php -d pcov.enabled=1 vendor/bin/infection --threads=max --min-msi=100 --min-covered-msi=100",
        "mutation:ci": "@php -d pcov.enabled=1 vendor/bin/infection --threads=max --min-msi=100 --min-covered-msi=100 --logger-github",
        "mutation:zones": "@php scripts/ci/gate.php mutation 100",
        "docs": "@php vendor/bin/doctum.php update doctum.php --no-progress",
        "bench": "phpbench run --report=aggregate --progress=none",
        "bench:regression": "phpbench run --report=aggregate --progress=none",
        "smoke:persistent": "@php scripts/ci/gate.php smoke",
        "lint": "@php scripts/ci/gate.php lint",
        "ci": [
            "@composer validate --strict",
            "@composer lint",
            "@composer stan",
            "@composer stan:ratchet",
            "@composer deptrac",
            "@composer format:check",
            "@composer phpcs",
            "@composer rector:check",
            "@composer test",
            "@composer smoke:persistent"
        ],
        "ci:strict": [
            "@composer validate --strict",
            "@composer lint",
            "@composer stan",
            "@composer stan:ratchet",
            "@composer deptrac",
            "@composer format:check",
            "@composer phpcs",
            "@composer rector:check",
            "@composer test",
            "@composer coverage:gate",
            "@composer mutation",
            "@composer mutation:zones",
            "@composer audit:strict",
            "@composer smoke:persistent",
            "@composer bench"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit test suite.",
        "coverage": "Run PHPUnit with a text coverage report.",
        "coverage:gate": "Run PHPUnit coverage (pcov) and enforce the 90% line-coverage gate.",
        "format": "Apply php-cs-fixer formatting.",
        "format:check": "Check formatting without modifying files.",
        "phpcs": "Run PHP_CodeSniffer with the strict PSR-12 + Slevomat ruleset.",
        "phpcbf": "Auto-fix PHP_CodeSniffer violations.",
        "rector": "Apply Rector refactorings.",
        "rector:check": "Dry-run Rector to detect needed refactorings.",
        "stan": "Run PHPStan static analysis at the strictest level.",
        "stan:ratchet": "Enforce the PHPStan baseline ratchet (no new errors).",
        "psalm": "Run Psalm static analysis at level 1 against the frozen baseline.",
        "archeology": "Run PhpCodeArcheology (architecture/maintainability metrics) with the strict quality gate.",
        "archeology:gate": "Enforce the PhpCodeArcheology gate (fail on any architecture error).",
        "deptrac": "Run Deptrac architecture-boundary analysis.",
        "audit:security": "Strict supply-chain gate (alias of audit:strict).",
        "audit:strict": "Strict supply-chain gate: fail on advisories or non allow-listed abandoned packages.",
        "mutation": "Run Infection mutation testing with MSI 100 gates.",
        "mutation:ci": "Run Infection in CI mode with GitHub annotations and MSI 100 gates.",
        "mutation:zones": "Enforce the mutation-score floor (MSI and covered MSI).",
        "docs": "Build the API documentation with Doctum.",
        "bench": "Run the PHPBench benchmarks with assertions.",
        "bench:regression": "Run PHPBench with the aggregate report.",
        "smoke:persistent": "Run the persistent-worker (RoadRunner) smoke test.",
        "lint": "Fast syntax lint of the codebase (via the tooling gate dispatcher).",
        "ci": "Full local CI pipeline (mirrors the standard GitHub Actions workflow).",
        "ci:strict": "Strict CI pipeline: every gate, including coverage, mutation and strict audit."
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
